{
  "name": "@codelex/lexicon",
  "version": "0.1.0",
  "private": true,
  "description": "CODELEX Lexicon: schema, seed data, formulas and validators.",
  "type": "module",
  "exports": {
    "./formulas": "./scripts/formulas.mjs",
