{
  "name": "@codelex/lexicon",
  "version": "0.1.0",
  "private": true,
  "description": "CODELEX Lexicon: schema, seed data, formulas, validators and the LexiconIndex contract.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./index": {
      "types": "./dist/index/index.d.ts",
      "default": "./dist/index/index.js"
    },
    "./formulas": "./scripts/formulas.mjs",
    "./validate": "./scripts/validate.mjs",
    "./canonical": "./scripts/canonical.mjs",
    "./schema/term.schema.json": "./schema/term.schema.json",
    "./data/*": "./data/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && node scripts/validate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.test.mjs\" && vitest run --coverage",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "@codelex/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "vitest": "5.0.2"
  }
}
