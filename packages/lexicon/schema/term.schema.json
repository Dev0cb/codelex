{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codelex.app/schemas/lexicon/term-file.v1.json",
  "title": "CODELEX lexicon term file",
  "type": "object",
  "required": ["schemaVersion", "category", "terms"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "terms": { "type": "array", "items": { "$ref": "#/$defs/term" } }
  },
  "$defs": {
    "term": {
      "type": "object",
      "required": ["id", "display", "playable", "kind", "categories", "difficulty", "definitions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "form": { "type": "string", "pattern": "^[A-Z]{2,15}$" },
        "display": { "type": "string", "minLength": 1, "maxLength": 40 },
        "playable": { "type": "boolean" },
        "kind": { "enum": ["concept", "product", "language", "protocol", "acronym", "tool", "standard"] },
        "owner": { "type": "string", "minLength": 2 },
        "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "difficulty": { "enum": ["novice", "intermediate", "advanced", "expert"] },
        "definitions": {
          "type": "object",
          "required": ["en", "fr"],
          "additionalProperties": false,
          "properties": {
            "en": { "type": "string", "minLength": 10, "maxLength": 160 },
            "fr": { "type": "string", "minLength": 10, "maxLength": 160 }
          }
        },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "target"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["is_a", "part_of", "uses", "related_to", "alternative_to", "runs_on", "implements"] },
              "target": { "type": "string" }
            }
          }
        },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "gameValue": { "type": "integer", "minimum": 0 },
        "knowledgeXp": { "type": "integer", "minimum": 0 },
        "override": {
          "type": "object",
          "required": ["approvedBy"],
          "additionalProperties": false,
          "properties": {
            "gameValue": { "type": "integer", "minimum": 0 },
            "knowledgeXp": { "type": "integer", "minimum": 0 },
            "approvedBy": { "type": "string" }
          }
        }
      }
    }
  }
}
