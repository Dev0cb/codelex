{
  "name": "@codelex/bots",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic AI opponents (random-legal, Beginner, greedy yardstick, Strategist; Architect\u2192Grandmaster later)",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./golden/decisions-b*.json": "./test/golden/decisions-b*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:full": "vitest run --config vitest.full.config.ts",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "simulate": "tsc -p tsconfig.sim.json && node dist/simulator/sim/cli.js",
    "simulate:b4": "tsc -p tsconfig.sim.json && node dist/simulator/sim/b4-cli.js",
    "readout": "tsc -p tsconfig.sim.json && node dist/simulator/sim/readout-cli.js"
  },
  "dependencies": {
    "@codelex/config": "workspace:*",
    "@codelex/game-engine": "workspace:*",
    "@codelex/lexicon": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "fast-check": "4.10.2",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  }
}
