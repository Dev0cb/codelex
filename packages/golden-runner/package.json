{
  "name": "@codelex/golden-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Golden runner (ADR-0016): pure runner core and corpus, Node and Hermes CLI hosts, runner/Diagnostics report schemas and the Node/Hermes comparison",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "golden:node": "node bin/golden-run.mjs",
    "golden:compare": "node bin/golden-compare.mjs",
    "golden:hermes:build": "node scripts/build-hermes.mjs"
  },
  "dependencies": {
    "@codelex/bots": "workspace:*",
    "@codelex/config": "workspace:*",
    "@codelex/game-engine": "workspace:*",
    "@codelex/lexicon": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "fast-check": "4.10.2",
    "vitest": "5.0.2"
  }
}
