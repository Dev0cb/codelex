{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runnerFormat": {
      "type": "number",
      "const": 1
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "node"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[\\x20-\\x7e]*$"
            }
          },
          "required": [
            "kind",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "hermes-cli",
                "hermes-app"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[\\x20-\\x7e]*$"
            },
            "bytecodeVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "version",
            "bytecodeVersion"
          ],
          "additionalProperties": false
        }
      ]
    },
    "corpus": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "allOf": [
            {
              "pattern": "^[\\x20-\\x7e]*$"
            },
            {
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "engineRulesVersions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "botVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "digest",
        "engineRulesVersions",
        "botVersion"
      ],
      "additionalProperties": false
    },
    "suites": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "allOf": [
              {
                "pattern": "^[\\x20-\\x7e]*$"
              },
              {
                "pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
              }
            ]
          },
          "cases": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[\\x20-\\x7e]*$"
                    },
                    "status": {
                      "type": "string",
                      "const": "pass"
                    },
                    "observed": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  "required": [
                    "id",
                    "status",
                    "observed"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[\\x20-\\x7e]*$"
                    },
                    "status": {
                      "type": "string",
                      "const": "fail"
                    },
                    "observed": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  "required": [
                    "id",
                    "status",
                    "observed"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[\\x20-\\x7e]*$"
                    },
                    "status": {
                      "type": "string",
                      "const": "error"
                    },
                    "errorCode": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "allOf": [
                        {
                          "pattern": "^[\\x20-\\x7e]*$"
                        },
                        {
                          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "status",
                    "errorCode"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "pass": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "fail": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "error": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "pass",
              "fail",
              "error"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "cases",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "timings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "allOf": [
          {
            "pattern": "^[\\x20-\\x7e]*$"
          },
          {
            "pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "totalMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "totalMs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "runnerFormat",
    "runtime",
    "corpus",
    "suites",
    "verdict"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[\\x20-\\x7e]*$"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[\\x20-\\x7e]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
