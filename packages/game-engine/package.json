{
  "name": "@codelex/game-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure rules engine (board, scoring, powers, modes)",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rng": {
      "types": "./dist/rng/index.d.ts",
      "default": "./dist/rng/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@codelex/config": "workspace:*",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "fast-check": "4.10.2",
    "vitest": "5.0.2"
  }
}
