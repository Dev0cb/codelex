{
  "name": "codelex",
  "private": true,
  "description": "CODELEX — Play the language of technology. Monorepo and agentic framework.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18 <23",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "validate": "pnpm framework:validate && pnpm lexicon:validate && pnpm test:framework && pnpm traceability:check && pnpm test:traceability",
    "framework:validate": "node tools/framework/validate.mjs",
    "lexicon:validate": "node packages/lexicon/scripts/validate.mjs",
    "test:framework": "node --test \"tools/framework/*.test.mjs\" \"tools/scaffold/*.test.mjs\" \"tools/golden/*.test.mjs\" \"tools/letters/*.test.mjs\" \"tools/hermes/*.test.mjs\"",
    "golden:immutability": "node tools/golden/immutability.mjs --base origin/main",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "affected": "turbo run lint typecheck format:check test --filter=...[origin/main]",
    "traceability:check": "node tools/traceability/check.mjs",
    "traceability:write": "node tools/traceability/check.mjs --write",
    "test:traceability": "node --test \"tools/traceability/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
