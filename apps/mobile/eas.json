{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "node": "22.22.0",
      "pnpm": "10.28.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CODELEX_FLAGS": "play_vs_bot.enabled=1"
      }
    },
    "preview-diagnostics": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_CODELEX_FLAGS": "play_vs_bot.enabled=1",
        "EXPO_PUBLIC_CODELEX_DIAGNOSTICS": "1"
      }
    }
  }
}
