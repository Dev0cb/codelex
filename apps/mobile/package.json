{
  "name": "@codelex/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "CODELEX mobile app (React Native + Expo, iOS and Android)",
  "license": "UNLICENSED",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform android --platform ios --source-maps --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check .",
    "test": "jest --coverage && node --test \"scripts/*.test.mjs\"",
    "prepare:lexicon": "node scripts/prepare-lexicon.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs dist && node scripts/check-bundle-contents.mjs dist"
  },
  "dependencies": {
    "@codelex/bots": "workspace:*",
    "@codelex/design-system": "workspace:*",
    "@codelex/game-engine": "workspace:*",
    "@codelex/i18n": "workspace:*",
    "@codelex/lexicon": "workspace:*",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "57.0.26",
    "expo-asset": "57.0.18",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-linking": "57.0.11",
    "expo-localization": "57.0.2",
    "expo-router": "57.0.24",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@codelex/config": "workspace:*",
    "@jest/globals": "29.7.0",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "test-renderer": "1.2.0",
    "vitest": "5.0.2"
  }
}
